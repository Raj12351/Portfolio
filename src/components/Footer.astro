---
import { SITE, SOCIALS, FREELANCE } from '../config';

const links = [{ label: 'Web design', href: '/websites' }, ...SOCIALS, ...FREELANCE, { label: 'RSS', href: '/rss.xml' }];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="muted">© {year} {SITE.name} · {SITE.location}</p>
    <ul class="links">
      {
        links.map((l) => (
          <li>
            <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 28px 0;
    margin-top: 40px;
    font-size: 0.9rem;
  }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .inner p {
    margin: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    color: var(--text-muted);
  }
  .links a:hover {
    color: var(--text);
  }
</style>
