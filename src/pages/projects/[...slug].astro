---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, context, stack, link } = project.data;
---

<Base title={title} description={summary}>
  <article class="section">
    <div class="container">
      <a href="/projects" class="back">← All work</a>
      <p class="eyebrow" style="margin-top:28px">{context}</p>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      <ul class="tags" style="margin:24px 0 8px">
        {stack.map((s) => <li class="tag">{s}</li>)}
      </ul>
      {link && <p><a href={link} target="_blank" rel="noopener noreferrer">View project →</a></p>}
      <hr class="divider" />
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .back {
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .divider {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 32px 0;
  }
</style>
