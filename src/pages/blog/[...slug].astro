---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags } = post.data;
const fmt = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={title} description={description}>
  <article class="section">
    <div class="container">
      <a href="/blog" class="back">← All writing</a>
      <header style="margin-top:28px">
        <p class="eyebrow"><time datetime={date.toISOString()}>{fmt}</time></p>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        {
          tags.length > 0 && (
            <ul class="tags" style="margin-top:20px">
              {tags.map((t) => <li class="tag">#{t}</li>)}
            </ul>
          )
        }
      </header>
      <hr class="divider" />
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .back {
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .divider {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 32px 0;
  }
</style>
