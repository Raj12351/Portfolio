---
import Demo from '../../../layouts/Demo.astro';

// Simple line illustrations stand in for product photography.
const icons: Record<string, string> = {
  candle:
    '<rect x="34" y="42" width="32" height="40" rx="4"/><path d="M50 42v-8"/><path d="M50 22c-5 6-5 10 0 12 5-2 5-6 0-12z"/><path d="M34 54h32"/><circle cx="44" cy="66" r="3"/><path d="M56 63a4 4 0 1 0 0 6 3 3 0 0 1 0-6z"/>',
  bag:
    '<path d="M28 44h44l-5 38H33z"/><path d="M38 44c0-14 24-14 24 0"/><path d="M31 54h38M32 64h36M33 74h34"/><path d="M40 44l-4 38M50 44v38M60 44l4 38"/>',
  macrame:
    '<path d="M24 26h52"/><path d="M32 26c0 14 18 14 18 28M68 26c0 14-18 14-18 28M42 26c0 10 8 14 8 20M58 26c0 10-8 14-8 20"/><circle cx="50" cy="56" r="3"/><path d="M50 59v12M44 60l-4 22M56 60l4 22M38 58l-6 20M62 58l6 20"/>',
  pendant:
    '<path d="M30 22c4 18 36 18 40 0"/><path d="M50 40v4"/><path d="M50 44l10 12-10 24-10-24z"/><path d="M40 56h20M50 44v36"/>',
  soap:
    '<rect x="26" y="44" width="48" height="30" rx="10"/><path d="M34 44c2-8 30-8 32 0"/><path d="M38 58c4-4 8 4 12 0s8 4 12 0"/><circle cx="68" cy="34" r="4"/><circle cx="60" cy="26" r="2.5"/>',
  incense:
    '<path d="M22 72c8 8 48 8 56 0"/><path d="M22 72c4-6 52-6 56 0"/><path d="M50 68V34"/><path d="M50 30c-6-6 6-10 0-16"/><path d="M56 26c-4-4 4-7 0-11"/>',
};

const products = [
  { name: 'Moon phase candle', note: 'Soy wax · cedar & vetiver', price: '₹890', icon: 'candle', tint: '#ead7c3', tag: 'Bestseller' },
  { name: 'Crochet market bag', note: 'Organic cotton · sage', price: '₹1,450', icon: 'bag', tint: '#dfe3d2', tag: '' },
  { name: 'Macramé wall hanging', note: 'Recycled cotton cord', price: '₹2,200', icon: 'macrame', tint: '#efe2d3', tag: 'Made to order' },
  { name: 'Rose quartz pendant', note: 'Hand-wrapped brass', price: '₹1,100', icon: 'pendant', tint: '#f1dcd6', tag: '' },
  { name: 'Neem & turmeric soap', note: 'Cold process · set of 3', price: '₹540', icon: 'soap', tint: '#f0e4c4', tag: 'New' },
  { name: 'Clay incense holder', note: 'Hand-thrown terracotta', price: '₹650', icon: 'incense', tint: '#e8d3c4', tag: '' },
];

const collections = ['All', 'Candles', 'Crochet', 'Macramé', 'Crystals', 'Soaps', 'Home'];
---

<Demo
  title="Mitti & Moon — handmade goods"
  description="Concept design for a small-batch handmade shop."
  fonts="family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@400;500;600"
>
  <div class="mm">
    <p class="announce">Free shipping across India on orders over ₹1,500 · Wrapped without plastic</p>

    <header class="nav wrap">
      <a class="logo" href="#top">Mitti <span>&amp;</span> Moon</a>
      <nav>
        <a href="#shop">Shop</a>
        <a href="#story">Our story</a>
        <button class="cart" type="button" aria-live="polite">Bag (<span id="count">0</span>)</button>
      </nav>
    </header>

    <section class="hero wrap" id="top">
      <div>
        <p class="eyebrow">Small-batch · handmade in Goa</p>
        <h1>Made slowly,<br />by hand, <em>under the moon.</em></h1>
        <p class="lead">Candles, crochet and little rituals for your home, each piece shaped by one pair of hands, never a machine.</p>
        <a class="btn" href="#shop">Shop the collection</a>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="arch">
          <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={icons.candle} />
        </div>
        <div class="moon"></div>
        <div class="dot d1"></div>
        <div class="dot d2"></div>
      </div>
    </section>

    <section class="shop wrap" id="shop">
      <div class="shop-head">
        <h2>The collection</h2>
        <div class="chips" role="list">
          {collections.map((c, i) => <button type="button" class:list={['chip', { active: i === 0 }]}>{c}</button>)}
        </div>
      </div>
      <div class="grid">
        {
          products.map((p) => (
            <article class="product">
              <div class="product-art" style={`background:${p.tint}`}>
                {p.tag && <span class="tag">{p.tag}</span>}
                <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[p.icon]} />
              </div>
              <div class="product-info">
                <div>
                  <h3>{p.name}</h3>
                  <p>{p.note}</p>
                </div>
                <p class="price">{p.price}</p>
              </div>
              <button class="add" type="button">Add to bag</button>
            </article>
          ))
        }
      </div>
    </section>

    <section class="story" id="story">
      <div class="wrap story-grid">
        <div class="seal" aria-hidden="true">
          <svg viewBox="0 0 200 200">
            <defs><path id="circle" d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0"></path></defs>
            <text><textPath href="#circle" textLength="458" lengthAdjust="spacing">handmade · small batch · with intention · </textPath></text>
          </svg>
          <span>☾</span>
        </div>
        <div>
          <p class="eyebrow">Our story</p>
          <h2>Mitti means earth.</h2>
          <p>
            Mitti &amp; Moon began on a veranda in Goa: one maker, a pot of soy wax and a lot of evenings. Today we're a
            circle of five women artisans, each working from home, at our own pace, with materials that come from the
            earth and can go back to it.
          </p>
          <ul class="values">
            <li><strong>Small batch</strong>Made in runs of 20 or fewer</li>
            <li><strong>Plastic free</strong>Paper, cloth and twine only</li>
            <li><strong>Fair to makers</strong>Every artisan sets her own price</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="letter wrap">
      <h2>Letters by moonlight</h2>
      <p>One gentle email at each new moon: new pieces, maker stories, and a small ritual to try.</p>
      <form onsubmit="event.preventDefault(); this.querySelector('.note').hidden = false;">
        <input type="email" placeholder="Your email" aria-label="Your email" autocomplete="off" />
        <button type="submit">Subscribe</button>
        <p class="note" hidden>This is a concept design, so nothing was sent.</p>
      </form>
    </section>

    <footer class="foot">
      <p class="logo">Mitti <span>&amp;</span> Moon</p>
      <p>Handmade in Assagao, Goa · hello@example.com</p>
    </footer>
  </div>
</Demo>

<script>
  let count = 0;
  const out = document.getElementById('count');
  document.querySelectorAll<HTMLButtonElement>('.add').forEach((btn) =>
    btn.addEventListener('click', () => {
      count += 1;
      if (out) out.textContent = String(count);
      btn.textContent = 'Added ✓';
      setTimeout(() => (btn.textContent = 'Add to bag'), 1200);
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip, _, all) =>
    chip.addEventListener('click', () => {
      all.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
    }),
  );
</script>

<style>
  .mm {
    --clay: #efe2d3;
    --paper: #f8f1e8;
    --terra: #8a4b2f;
    --sage: #5c6b4e;
    --ink: #33261d;
    --muted: #7a685a;
    background: var(--paper);
    color: var(--ink);
    font: 400 16px/1.65 'DM Sans', system-ui, sans-serif;
  }
  .mm h1,
  .mm h2,
  .mm h3,
  .logo {
    font-family: 'DM Serif Display', Georgia, serif;
    font-weight: 400;
    line-height: 1.08;
    margin: 0 0 0.4em;
  }
  .mm p {
    margin: 0 0 1em;
  }
  .wrap {
    max-width: 1160px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }
  .eyebrow {
    color: var(--sage);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .announce {
    margin: 0;
    background: var(--terra);
    color: #f8ecdf;
    text-align: center;
    font-size: 0.85rem;
    padding: 8px 16px;
  }
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 22px;
    padding-bottom: 22px;
  }
  .logo {
    font-size: 1.8rem;
    color: var(--ink);
    text-decoration: none;
    margin: 0;
  }
  .logo span {
    font-style: italic;
    color: var(--terra);
  }
  .nav nav {
    display: flex;
    gap: 22px;
    align-items: center;
  }
  .nav a {
    color: var(--ink);
    text-decoration: none;
  }
  .cart {
    font: inherit;
    font-weight: 600;
    background: var(--ink);
    color: var(--paper);
    border: 0;
    padding: 8px 16px;
    border-radius: 999px;
    cursor: pointer;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
    padding-top: clamp(32px, 6vw, 72px);
    padding-bottom: clamp(56px, 9vw, 110px);
  }
  .hero h1 {
    font-size: clamp(2.8rem, 6.4vw, 5.2rem);
  }
  .hero h1 em {
    color: var(--terra);
  }
  .lead {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 46ch;
  }
  .btn {
    display: inline-block;
    background: var(--terra);
    color: #fff;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 999px;
    font-weight: 600;
  }
  .hero-art {
    position: relative;
    aspect-ratio: 4 / 5;
  }
  .arch {
    position: absolute;
    inset: 6% 8% 0 8%;
    background: var(--clay);
    border-radius: 999px 999px 18px 18px;
    display: grid;
    place-items: center;
    color: var(--terra);
  }
  .arch svg {
    width: 62%;
  }
  .moon {
    position: absolute;
    top: 0;
    right: 4%;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #e9c98f;
    box-shadow: inset -14px -6px 0 0 #d8ae66;
  }
  .dot {
    position: absolute;
    border-radius: 50%;
    background: var(--sage);
  }
  .d1 {
    width: 14px;
    height: 14px;
    left: 2%;
    top: 30%;
  }
  .d2 {
    width: 9px;
    height: 9px;
    left: 10%;
    bottom: 12%;
    background: var(--terra);
  }

  .shop {
    padding-bottom: clamp(56px, 9vw, 110px);
  }
  .shop-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .shop-head h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0;
  }
  .chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .chip {
    font: inherit;
    font-size: 0.88rem;
    background: transparent;
    border: 1px solid #d9c6b2;
    color: var(--ink);
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
  }
  .chip.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 32px 24px;
  }
  .product-art {
    position: relative;
    aspect-ratio: 1;
    border-radius: 14px;
    display: grid;
    place-items: center;
    color: var(--terra);
    transition: transform 0.25s ease;
  }
  .product:hover .product-art {
    transform: translateY(-3px);
  }
  .product-art svg {
    width: 58%;
  }
  .tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--paper);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
  }
  .product-info {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
  }
  .product h3 {
    font-size: 1.25rem;
    margin: 0;
  }
  .product-info p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .product-info .price {
    color: var(--ink);
    font-weight: 600;
    font-size: 1rem;
    white-space: nowrap;
  }
  .add {
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    width: 100%;
    margin-top: 12px;
    background: transparent;
    border: 1px solid var(--ink);
    color: var(--ink);
    padding: 9px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .add:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .story {
    background: var(--sage);
    color: #eef0e6;
    padding: clamp(64px, 9vw, 110px) 0;
  }
  .story h2 {
    color: #fff;
    font-size: clamp(2.2rem, 4.6vw, 3.4rem);
  }
  .story .eyebrow {
    color: #e9c98f;
  }
  .story-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .seal {
    position: relative;
    width: min(100%, 320px);
    aspect-ratio: 1;
    margin: 0 auto;
    animation: spin 40s linear infinite;
  }
  .seal svg {
    width: 100%;
    fill: #eef0e6;
    font: 600 13px 'DM Sans', sans-serif;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  .seal span {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 4rem;
    color: #e9c98f;
    animation: spin 40s linear infinite reverse;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .seal,
    .seal span {
      animation: none;
    }
  }
  .values {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .values li {
    border-top: 1px solid rgb(255 255 255 / 0.3);
    padding-top: 12px;
    font-size: 0.92rem;
  }
  .values strong {
    display: block;
    color: #fff;
    font-family: 'DM Serif Display', serif;
    font-weight: 400;
    font-size: 1.2rem;
  }

  .letter {
    text-align: center;
    padding-top: clamp(64px, 9vw, 110px);
    padding-bottom: clamp(64px, 9vw, 110px);
    max-width: 640px;
  }
  .letter h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }
  .letter p {
    color: var(--muted);
  }
  .letter form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 20px;
  }
  .letter input {
    font: inherit;
    flex: 1 1 240px;
    padding: 12px 18px;
    border-radius: 999px;
    border: 1px solid #d9c6b2;
    background: #fff;
  }
  .letter button {
    font: inherit;
    font-weight: 600;
    background: var(--terra);
    color: #fff;
    border: 0;
    padding: 12px 24px;
    border-radius: 999px;
    cursor: pointer;
  }
  .letter .note {
    flex-basis: 100%;
    margin: 0;
    color: var(--terra);
  }

  .foot {
    background: var(--clay);
    text-align: center;
    padding: 44px 20px;
  }
  .foot p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .foot .logo {
    margin-bottom: 6px;
  }

  @media (max-width: 820px) {
    .hero,
    .story-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      max-width: 340px;
      width: 100%;
      margin: 0 auto;
    }
    .nav nav a {
      display: none;
    }
    .values {
      grid-template-columns: 1fr;
    }
    .seal {
      width: 220px;
    }
  }
</style>
