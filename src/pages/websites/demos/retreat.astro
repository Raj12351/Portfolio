---
import Demo from '../../../layouts/Demo.astro';

const retreats = [
  { season: 'Spring', title: 'Return to Breath', dates: '14 – 20 March 2027', seats: '4 places left', price: '₹48,000' },
  { season: 'Summer', title: 'Forest Silence', dates: '6 – 12 June 2027', seats: 'Applications open', price: '₹52,000' },
  { season: 'Autumn', title: 'The Quiet Mountain', dates: '3 – 9 October 2027', seats: 'Applications open', price: '₹48,000' },
];

const rhythm = [
  { time: '6:30', title: 'Pranayama & silent sitting', body: 'We begin before the valley wakes, with breath and stillness.' },
  { time: '8:00', title: 'Hatha practice', body: 'Slow, alignment-led asana for every body and level.' },
  { time: '10:00', title: 'Nourishing brunch', body: 'Seasonal, vegetarian, cooked in the village.' },
  { time: '12:00', title: 'Free time or forest walk', body: 'Rest, read, journal, or follow the deodar trails.' },
  { time: '17:00', title: 'Yin & yoga nidra', body: 'A long exhale to close the day.' },
  { time: '19:30', title: 'Fire circle & dinner', body: 'Sharing, music, or simply silence under the stars.' },
];

const included = ['6 nights in a mountain guesthouse', 'Two yoga sessions daily', 'All vegetarian meals', 'Guided Triund trek', 'Meditation at a Buddhist centre', 'Small group: 8 people at most'];
---

<Demo
  title="Sattva Himalaya — yoga retreats in Dharamkot"
  description="Concept design for a small yoga retreat in the Himalayas."
  fonts="family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@300;400;500"
>
  <div class="sh">
    <header class="nav">
      <a class="logo" href="#top">Sattva <em>Himalaya</em></a>
      <nav>
        <a href="#retreats">Retreats</a>
        <a href="#rhythm">A day here</a>
        <a href="#apply" class="pill">Apply</a>
      </nav>
    </header>

    <section class="hero" id="top">
      <img src="/images/wmj/golden-peaks.webp" alt="Snow peaks catching the last golden light" />
      <div class="hero-text">
        <p class="kicker">Yoga &amp; meditation retreats · Dharamkot, Himachal</p>
        <h1>Come back to<br /><em>yourself.</em></h1>
        <p>Seven slow days of breath, movement and mountain silence, in a group of eight.</p>
        <a class="btn" href="#retreats">See 2027 retreats</a>
      </div>
    </section>

    <section class="intro wrap">
      <div>
        <p class="kicker dark">Our way</p>
        <h2>Not an escape. A homecoming.</h2>
        <p>
          Sattva means clarity, the quality of a still lake. Our retreats leave space between things: for rest, for
          long walks under deodar trees, for conversations that go somewhere real. No packed schedules, no performance.
          Just practice, nourishing food, and the mountains doing what they do.
        </p>
        <p class="sig">— Ananya &amp; Tenzin, your hosts</p>
      </div>
      <img src="/images/wmj/triund-camp.webp" alt="A view of the Dhauladhar range from a tent door at dawn" loading="lazy" />
    </section>

    <section class="retreats" id="retreats">
      <div class="wrap">
        <p class="kicker dark">2027 retreats</p>
        <h2>Three seasons, three intentions</h2>
        <div class="cards">
          {
            retreats.map((r) => (
              <article class="card">
                <p class="season">{r.season}</p>
                <h3>{r.title}</h3>
                <p class="dates">{r.dates}</p>
                <div class="meta">
                  <span>{r.seats}</span>
                  <span>
                    from <strong>{r.price}</strong>
                  </span>
                </div>
                <a href="#apply">Apply for this retreat →</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="rhythm wrap" id="rhythm">
      <div class="rhythm-head">
        <p class="kicker dark">A day here</p>
        <h2>The gentle rhythm</h2>
        <p>Every session is an invitation, never an obligation.</p>
        <ul class="included">
          {included.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <ol class="timeline">
        {
          rhythm.map((r) => (
            <li>
              <span class="time">{r.time}</span>
              <div>
                <h3>{r.title}</h3>
                <p>{r.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="quote">
      <blockquote>
        “I arrived exhausted and left with a quiet I still carry. The mornings on that terrace changed something in me.”
        <cite>Sample guest review</cite>
      </blockquote>
    </section>

    <section class="apply wrap" id="apply">
      <div>
        <p class="kicker dark">Apply</p>
        <h2>Tell us a little about you</h2>
        <p>We keep groups small and intentional. Share a few lines and we'll write back personally within two days.</p>
      </div>
      <form class="form" onsubmit="event.preventDefault(); this.querySelector('.note').hidden = false;">
        <label>Your name<input type="text" autocomplete="off" /></label>
        <label>Email<input type="email" autocomplete="off" /></label>
        <label
          >Retreat
          <select>
            {retreats.map((r) => <option>{r.title} · {r.dates}</option>)}
          </select>
        </label>
        <label>What are you hoping for?<textarea rows="4"></textarea></label>
        <button type="submit">Send application</button>
        <p class="note" hidden>This is a concept design, so nothing was sent.</p>
      </form>
    </section>

    <footer class="foot">
      <p class="logo">Sattva <em>Himalaya</em></p>
      <p>Upper Dharamkot, Himachal Pradesh · hello@example.com</p>
    </footer>
  </div>
</Demo>

<style>
  .sh {
    --cream: #f3eee4;
    --paper: #fbf8f2;
    --green: #2f4a3a;
    --ochre: #c98d4a;
    --ink: #2b2a26;
    --muted: #6d675c;
    background: var(--cream);
    color: var(--ink);
    font: 300 17px/1.7 'Jost', system-ui, sans-serif;
  }
  .sh h1,
  .sh h2,
  .sh h3,
  .logo {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 0.4em;
  }
  .sh h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--green);
  }
  .sh h3 {
    font-size: 1.6rem;
  }
  .sh p {
    margin: 0 0 1em;
  }
  em {
    font-style: italic;
  }
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .kicker {
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .kicker.dark {
    color: var(--ochre);
  }

  .nav {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px clamp(20px, 4vw, 48px);
    color: #fff;
  }
  .logo {
    font-size: 1.7rem;
    color: inherit;
    text-decoration: none;
    margin: 0;
  }
  .nav nav {
    display: flex;
    gap: 22px;
    align-items: center;
  }
  .nav nav a {
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .pill {
    border: 1px solid rgb(255 255 255 / 0.7);
    padding: 6px 18px;
    border-radius: 999px;
  }

  .hero {
    position: relative;
    min-height: min(92vh, 820px);
    display: grid;
    align-items: end;
    color: #fff;
    overflow: hidden;
  }
  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(10 15 12 / 0.25), rgb(10 15 12 / 0.1) 40%, rgb(10 15 12 / 0.7));
  }
  .hero-text {
    position: relative;
    z-index: 1;
    padding: 0 clamp(20px, 6vw, 80px) clamp(48px, 9vh, 96px);
    max-width: 760px;
  }
  .hero h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    color: #fff;
  }
  .hero h1 em {
    color: #f0c78a;
  }
  .btn {
    display: inline-block;
    margin-top: 8px;
    background: var(--ochre);
    color: #fff;
    text-decoration: none;
    padding: 13px 28px;
    border-radius: 999px;
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .intro {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
    padding-top: clamp(64px, 10vw, 120px);
    padding-bottom: clamp(64px, 10vw, 120px);
  }
  .intro img {
    border-radius: 220px 220px 8px 8px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    width: 100%;
  }
  .sig {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.3rem;
    color: var(--green);
  }

  .retreats {
    background: var(--green);
    color: #e9e4d8;
    padding: clamp(64px, 9vw, 110px) 0;
  }
  .retreats h2 {
    color: #fff;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    margin-top: 32px;
  }
  .card {
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 6px;
    padding: 30px 28px;
    transition: background 0.2s ease;
  }
  .card:hover {
    background: rgb(255 255 255 / 0.05);
  }
  .season {
    color: #f0c78a;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .card h3 {
    color: #fff;
    font-size: 2rem;
  }
  .dates {
    font-size: 1.05rem;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid rgb(255 255 255 / 0.2);
    padding-top: 14px;
    margin-bottom: 18px;
    font-size: 0.92rem;
  }
  .card a {
    color: #f0c78a;
    text-decoration: none;
  }

  .rhythm {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 88px);
    padding-top: clamp(64px, 10vw, 120px);
    padding-bottom: clamp(64px, 10vw, 120px);
  }
  .included {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 8px;
  }
  .included li::before {
    content: '✦';
    color: var(--ochre);
    margin-right: 10px;
    font-size: 0.8rem;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid #ddd3c2;
  }
  .time {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem;
    color: var(--ochre);
    line-height: 1.1;
  }
  .timeline h3 {
    font-size: 1.4rem;
    margin-bottom: 2px;
  }
  .timeline p {
    margin: 0;
    color: var(--muted);
  }

  .quote {
    background: var(--paper);
    padding: clamp(64px, 9vw, 110px) 20px;
    text-align: center;
  }
  blockquote {
    max-width: 820px;
    margin: 0 auto;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.3;
    color: var(--green);
  }
  cite {
    display: block;
    margin-top: 18px;
    font: normal 400 0.8rem/1 'Jost', sans-serif;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .apply {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 88px);
    padding-top: clamp(64px, 10vw, 120px);
    padding-bottom: clamp(64px, 10vw, 120px);
  }
  .form {
    display: grid;
    gap: 16px;
    background: var(--paper);
    padding: 32px;
    border-radius: 8px;
  }
  .form label {
    display: grid;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 400;
  }
  .form input,
  .form select,
  .form textarea {
    font: inherit;
    padding: 11px 14px;
    border: 1px solid #d9cfbd;
    border-radius: 4px;
    background: #fff;
    color: var(--ink);
  }
  .form input:focus,
  .form select:focus,
  .form textarea:focus {
    outline: 2px solid var(--ochre);
    outline-offset: 1px;
  }
  .form button {
    font: inherit;
    background: var(--green);
    color: #fff;
    border: 0;
    padding: 13px;
    border-radius: 999px;
    cursor: pointer;
    letter-spacing: 0.04em;
  }
  .note {
    margin: 0;
    color: var(--ochre);
    font-size: 0.9rem;
  }

  .foot {
    background: #26372d;
    color: #c9c2b4;
    text-align: center;
    padding: 48px 20px;
  }
  .foot .logo {
    color: #fff;
    margin-bottom: 8px;
  }
  .foot p {
    margin: 0;
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .intro,
    .rhythm,
    .apply {
      grid-template-columns: 1fr;
    }
    .nav nav a:not(.pill) {
      display: none;
    }
    .intro img {
      max-width: 420px;
    }
    .form {
      padding: 22px;
    }
  }
</style>
