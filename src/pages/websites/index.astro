---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';

const audiences = [
  { title: 'Yoga & meditation teachers', body: 'Class schedules, teacher training pages, and a home for your philosophy.' },
  { title: 'Retreat & journey hosts', body: 'Itineraries, dates, what is included, and an easy way to apply or enquire.' },
  { title: 'Healers & coaches', body: 'Breathwork, sound healing, reiki, somatic work. Sessions, programs and bookings.' },
  { title: 'Artisans & makers', body: 'Crochet, macramé, candles, crystals, soaps. A shop that feels as handmade as your work.' },
  { title: 'Writers & course creators', body: 'Journals, newsletters, and course pages that turn readers into students.' },
];

const features = [
  'Retreat & journey pages with day-by-day itineraries',
  'Enquiries via WhatsApp, email or an availability calendar',
  'Programs with application forms',
  'Online courses and live event registration',
  'A shop for handmade goods',
  'Teacher & practitioner directories',
  'Journal / blog for your stories',
  'Photo galleries and reviews',
  'An admin area so you can update things yourself',
  'Fast, mobile-first and easy to find on Google',
];

const demos = [
  {
    href: '/websites/demos/retreat',
    name: 'Sattva Himalaya',
    kind: 'Yoga retreat',
    note: 'Calm, spacious, photo-led. Retreat dates, daily rhythm and an application flow.',
    image: '/images/wmj/triund-camp.webp',
    swatches: ['#f3eee4', '#2f4a3a', '#c98d4a'],
  },
  {
    href: '/websites/demos/artisan',
    name: 'Mitti & Moon',
    kind: 'Handmade shop',
    note: 'Earthy and tactile. A small-batch shop with collections, maker story and gentle checkout.',
    image: null,
    swatches: ['#efe2d3', '#8a4b2f', '#5c6b4e'],
  },
  {
    href: '/websites/demos/journal',
    name: 'Slow Pages',
    kind: 'Journaling course',
    note: 'Quiet, literary and warm. A 21-day course page with modules, free prompts and a journal.',
    image: '/images/wmj/pichola-sunset.webp',
    swatches: ['#f7f3ec', '#1f2a44', '#d97a4a'],
  },
];

const process = [
  { title: 'A heart-to-heart call', body: 'We talk about you, your offering, and the people you want to reach. Free, about 30 minutes.' },
  { title: 'Look & feel', body: 'A small moodboard of colours, fonts and photos, so you see the direction before anything is built.' },
  { title: 'Build & refine', body: 'You get a private preview link early and we shape it together.' },
  { title: 'Launch & care', body: 'Domain, hosting and Google setup handled. I show you how to update it yourself.' },
];

const packages = [
  {
    name: 'Seed',
    for: 'Starting out',
    items: ['One beautiful page', 'Your story, offerings and contact', 'WhatsApp & email enquiries', 'Mobile-first, fast, SEO basics'],
  },
  {
    name: 'Grow',
    for: 'Most teachers & hosts',
    items: ['Up to ~6 pages', 'Retreat / program / service pages', 'Journal or blog', 'Booking calendar or application form', 'Gallery and reviews'],
    highlight: true,
  },
  {
    name: 'Bloom',
    for: 'Communities & platforms',
    items: ['Everything in Grow', 'Shop or course platform', 'Practitioner directory or events', 'Admin area to manage it all', 'Payments (Razorpay, Stripe, PayPal)'],
  },
];

const faqs = [
  { q: 'Do I need to have all my content ready?', a: 'No. Bring what you have: a few photos, notes, voice messages. I help shape it into clear, warm copy.' },
  { q: 'Can I update the website myself?', a: 'Yes. Depending on the site, you can edit pages, add retreats, publish journal posts or list products without touching code.' },
  { q: 'Can I take payments?', a: 'Yes. Bookings, deposits, course sales and shop orders through Razorpay, Stripe or PayPal, depending on where your clients are.' },
  { q: 'Will it work well on phones?', a: 'Every site is designed mobile-first. Most of your visitors will arrive from Instagram or WhatsApp on a phone.' },
  { q: 'Do you help with the domain and hosting?', a: 'Yes. I set up your domain, hosting and a professional email address, and explain the yearly costs upfront.' },
];
---

<Base
  title="Websites for conscious brands"
  description="Beautiful, calm websites for yoga teachers, retreat hosts, healers and artisans, designed and built by Rajat Pal."
  skin="earth"
  image="/images/wmj/rishikesh-ganga-sunset.webp"
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Web design for conscious brands</p>
        <h1>Websites for yoga teachers, retreat hosts, healers &amp; makers.</h1>
        <p class="lead">
          Calm, beautiful sites that tell your story and quietly handle the practical parts: bookings, applications,
          courses and shop orders. Designed by someone who travels, practises and lives this world, and builds
          software for a living.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href="/contact">Plan your website</a>
          <a class="btn" href="#work">See my work</a>
        </div>
      </div>
      <div class="collage" aria-hidden="true">
        <img class="c1" src="/images/wmj/rishikesh-ganga-sunset.webp" alt="" width="1400" height="2486" loading="eager" />
        <img class="c2" src="/images/wmj/triund-camp.webp" alt="" width="867" height="1156" />
        <img class="c3" src="/images/wmj/kyarki-sunset.webp" alt="" width="1156" height="867" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Who I work with</p>
      <h2>For people whose work comes from the heart</h2>
      <div class="audiences">
        {
          audiences.map((a) => (
            <div class="card">
              <h3>{a.title}</h3>
              <p class="muted">{a.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="container">
      <p class="eyebrow">Featured work</p>
      <article class="feature card">
        <img src="/images/wmj/ladakh-thiksey.webp" alt="The Indus valley and snow peaks seen from Thiksey Monastery, Ladakh" width="1400" height="1867" loading="lazy" />
        <div class="feature-body">
          <h2>Wild &amp; Mindful Journeys</h2>
          <p class="muted">
            My own platform for mindful travel in India: small-group journeys, a 1:1 travel companion service, live
            sessions from yoga and breathwork teachers, a 12-week program and a marketplace for handmade crafts.
          </p>
          <ul class="tags">
            <li class="tag">Journeys & itineraries</li>
            <li class="tag">Teacher directory</li>
            <li class="tag">Live events</li>
            <li class="tag">Program applications</li>
            <li class="tag">Craft marketplace</li>
            <li class="tag">Availability calendar</li>
            <li class="tag">Admin dashboard</li>
          </ul>
          <div class="cta">
            <a class="btn btn-primary" href="https://www.wildandmindfuljourneys.com/" target="_blank" rel="noopener noreferrer">Visit the site ↗</a>
            <a class="btn" href="/projects/wild-and-mindful-journeys">Read the case study</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Concept designs</p>
      <h2>A few directions, to spark ideas</h2>
      <p class="lead">Each one is a fictional brand, designed to show a different mood. Yours would be shaped around you.</p>
      <div class="demos">
        {
          demos.map((d) => (
            <a class="demo card" href={d.href}>
              <div class="demo-visual" style={`--a:${d.swatches[0]};--b:${d.swatches[1]};--c:${d.swatches[2]}`}>
                {d.image ? <img src={d.image} alt="" loading="lazy" /> : <span class="demo-mark">{d.name}</span>}
              </div>
              <p class="demo-kind">{d.kind}</p>
              <h3>{d.name}</h3>
              <p class="muted">{d.note}</p>
              <div class="swatches" aria-hidden="true">
                {d.swatches.map((s) => <span style={`background:${s}`} />)}
              </div>
              <span class="more">Open the concept →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <p class="eyebrow">What your site can do</p>
        <h2>Beautiful on the outside, organised on the inside</h2>
        <p class="lead">
          A website should take work off your plate. I build the practical pieces properly, so enquiries, bookings and
          orders arrive in one calm place.
        </p>
      </div>
      <ul class="features">
        {features.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">How we work together</p>
      <h2>A gentle, clear process</h2>
      <ol class="steps">
        {
          process.map((p, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p class="muted">{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Ways to begin</p>
      <h2>Choose a starting point</h2>
      <p class="lead">Every project is quoted on its scope. Share your idea and I'll send a clear proposal.</p>
      <div class="packages">
        {
          packages.map((p) => (
            <div class:list={['card', 'package', { highlight: p.highlight }]}>
              {p.highlight && <span class="badge">Most chosen</span>}
              <h3>{p.name}</h3>
              <p class="for">{p.for}</p>
              <ul>
                {p.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Questions</p>
      <h2>Things people often ask</h2>
      <div class="faqs">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p class="muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="closing">
        <img src="/images/wmj/pushkar-sunset.webp" alt="" loading="lazy" />
        <div class="closing-body">
          <h2>Let's give your work the home it deserves.</h2>
          <p>Tell me a little about what you offer and who it's for. I'll reply within a day.</p>
          <div class="cta">
            <a class="btn btn-light" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Website enquiry')}`}>Email me</a>
            <a class="btn btn-ghost" href="/contact">Other ways to reach me</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 72px 0 64px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    line-height: 1.08;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .collage {
    position: relative;
    height: 520px;
  }
  .collage img {
    position: absolute;
    object-fit: cover;
    border-radius: 200px 200px 18px 18px;
    box-shadow: 0 24px 50px -24px rgb(60 40 20 / 0.45);
  }
  .c1 {
    width: 52%;
    height: 92%;
    left: 4%;
    top: 0;
  }
  .c2 {
    width: 40%;
    height: 54%;
    right: 2%;
    top: 6%;
    border-radius: 18px !important;
  }
  .c3 {
    width: 46%;
    height: 34%;
    right: 0;
    bottom: 0;
    border-radius: 18px !important;
  }

  .audiences {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 16px;
    margin-top: 28px;
  }
  .audiences .card p {
    margin: 0;
    font-size: 0.95rem;
  }

  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0;
    overflow: hidden;
  }
  .feature img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
    object-position: center 62%;
  }
  .feature-body {
    padding: 36px;
  }

  .demos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    margin-top: 28px;
  }
  .demo {
    display: flex;
    flex-direction: column;
    color: var(--text);
    padding: 14px 14px 22px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .demo:hover {
    text-decoration: none;
    transform: translateY(-3px);
    box-shadow: 0 20px 40px -24px rgb(60 40 20 / 0.4);
  }
  .demo-visual {
    position: relative;
    height: 190px;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 18px;
    background: linear-gradient(135deg, var(--a), color-mix(in srgb, var(--c) 45%, var(--a)));
    display: grid;
    place-items: center;
  }
  .demo-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
  }
  .demo-mark {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 2rem;
    color: var(--b);
  }
  .demo h3,
  .demo p,
  .demo .more {
    padding: 0 8px;
  }
  .demo-kind {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin-bottom: 4px;
  }
  .demo .muted {
    flex: 1;
    font-size: 0.95rem;
  }
  .swatches {
    display: flex;
    gap: 6px;
    padding: 0 8px;
    margin-bottom: 14px;
  }
  .swatches span {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid var(--border);
  }
  .more {
    font-weight: 600;
    color: var(--accent);
    font-size: 0.95rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .features li {
    position: relative;
    padding: 12px 16px 12px 44px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .features li::before {
    content: '';
    position: absolute;
    left: 16px;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-top: -7px;
    border-radius: 50% 0 50% 0;
    background: var(--accent);
    opacity: 0.8;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 28px;
  }
  .steps li {
    border-top: 2px solid var(--accent);
    padding-top: 18px;
  }
  .num {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: var(--accent-2);
  }
  .steps h3 {
    margin: 6px 0 8px;
  }

  .packages {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 20px;
    margin-top: 28px;
  }
  .package {
    position: relative;
  }
  .package.highlight {
    border: 2px solid var(--accent);
  }
  .badge {
    position: absolute;
    top: -12px;
    right: 18px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 12px;
    border-radius: 999px;
  }
  .package h3 {
    font-size: 1.6rem;
    margin-bottom: 2px;
  }
  .for {
    color: var(--accent-2);
    font-size: 0.9rem;
  }
  .package ul {
    padding-left: 1.1em;
    margin: 0;
    color: var(--text-muted);
  }
  .package li {
    margin: 6px 0;
  }

  .narrow {
    max-width: 760px;
  }
  .faqs {
    margin-top: 24px;
  }
  details {
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-size: 1.3rem;
    line-height: 1;
    color: var(--accent);
  }
  details[open] summary::after {
    content: '–';
  }
  details p {
    margin: 10px 0 0;
  }

  .closing {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    min-height: 360px;
    display: grid;
    align-items: end;
  }
  .closing img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .closing::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(30 20 10 / 0.05), rgb(30 20 10 / 0.75));
  }
  .closing-body {
    position: relative;
    z-index: 1;
    padding: 40px;
    color: #fffaf0;
    max-width: 640px;
  }
  .closing-body h2 {
    color: #fffaf0;
  }
  .btn-light {
    background: #fffaf0;
    color: #2f2a24;
    border-color: #fffaf0;
  }
  .btn-ghost {
    background: transparent;
    color: #fffaf0;
    border-color: rgb(255 250 240 / 0.6);
  }

  @media (max-width: 860px) {
    .hero-grid,
    .two-col,
    .feature {
      grid-template-columns: 1fr;
    }
    .collage {
      height: 380px;
    }
    .feature-body {
      padding: 24px;
    }
    .closing-body {
      padding: 28px 22px;
    }
  }
</style>
