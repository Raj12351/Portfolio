---
import Base from '../layouts/Base.astro';
import { SITE, EXPERIENCE, EDUCATION } from '../config';
---

<Base title="About" description="About Rajat Pal: AI engineer, forward-deployed engineer at Infosys, former Amazon SDE intern.">
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">About</p>
      <h1>I turn GenAI ideas into systems that run in production.</h1>
      <div class="prose">
        <p>
          I'm {SITE.name}, a software engineer based in {SITE.location}. I started on backend systems, building REST
          microservices at Amazon and later for enterprise e-commerce. Over the last few years my work has moved almost
          entirely into GenAI.
        </p>
        <p>
          Today I work as a forward-deployed engineer: I sit with business and data science teams, figure out where AI
          actually helps, and own each use case from scoping to production. That has meant building an agentic AI
          platform, RAG pipelines, observability for multi-agent systems, and the evaluation practices that tell us
          whether any of it is working.
        </p>
        <p>
          What I care about most is the gap between a demo and a dependable product: retrieval that returns the right
          context, agents you can trace and debug, and changes you can measure before you ship.
        </p>
      </div>
      {
        SITE.resumeUrl && (
          <p style="margin-top:24px">
            <a class="btn" href={SITE.resumeUrl}>Download resume (PDF)</a>
          </p>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Experience</h2>
      <ol class="timeline">
        {
          EXPERIENCE.map((job) => (
            <li>
              <div class="when">{job.period}</div>
              <div>
                <h3>{job.company}</h3>
                <p class="role">{job.role}</p>
                <ul class="points">
                  {job.points.map((pt) => <li>{pt}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>

      <h2 style="margin-top:56px">Education</h2>
      <div class="card">
        <h3 style="margin-bottom:4px">{EDUCATION.degree}</h3>
        <p class="muted" style="margin:0">{EDUCATION.school} · {EDUCATION.year}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 820px;
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
  }
  .timeline > li {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--border);
  }
  .when {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    padding-top: 4px;
  }
  .timeline h3 {
    margin-bottom: 2px;
  }
  .role {
    color: var(--accent-2);
    font-size: 0.95rem;
    margin-bottom: 10px;
  }
  .points {
    padding-left: 1.2em;
    margin: 0;
    color: var(--text-muted);
  }
  .points li {
    margin: 6px 0;
  }
  @media (max-width: 640px) {
    .timeline > li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
