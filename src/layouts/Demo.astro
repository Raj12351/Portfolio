---
// Standalone layout for concept designs: each demo brings its own fonts and palette.
// A slim banner makes clear it is a fictional concept and links back to the portfolio.
interface Props {
  title: string;
  description: string;
  fonts: string; // Google Fonts css2 "family=" query, e.g. 'family=Cormorant+Garamond:wght@400;600'
}

const { title, description, fonts } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Concept by Rajat Pal</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} rel="stylesheet" />
  </head>
  <body>
    <div class="concept-bar">
      <span>Concept design · fictional brand</span>
      <a href="/websites">← Rajat Pal · Web design</a>
    </div>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    -webkit-font-smoothing: antialiased;
  }
  img {
    max-width: 100%;
    display: block;
  }
  .concept-bar {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 16px;
    font: 500 12px/1.4 system-ui, -apple-system, 'Segoe UI', sans-serif;
    background: #1d1b18;
    color: #d9d2c5;
  }
  .concept-bar a {
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }
  .concept-bar a:hover {
    text-decoration: underline;
  }
</style>
